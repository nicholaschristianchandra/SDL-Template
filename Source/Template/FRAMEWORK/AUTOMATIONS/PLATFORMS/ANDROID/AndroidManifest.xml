<?xml version="1.0" encoding="utf-8"?>
<!-- Build.bat fills in the values in double braces. Based on the manifest in SDL's android-project. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="{{PACKAGE}}"
    android:versionCode="{{VERSION_CODE}}"
    android:versionName="{{VERSION_NAME}}"
    android:installLocation="auto">

    <uses-sdk android:minSdkVersion="{{MIN_SDK}}" android:targetSdkVersion="{{TARGET_SDK}}" />

    <!-- OpenGL ES 2.0 -->
    <uses-feature android:glEsVersion="0x00020000" />

    <!-- Touchscreen, game controllers and external mice are used when present -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />

    <!-- Permissions, each kept when its Config.bat setting is TRUE -->
    <uses-permission android:name="android.permission.VIBRATE" /> <!-- Config.bat: VIBRATE -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" /> <!-- Config.bat: MICROPHONE -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" /> <!-- Config.bat: MICROPHONE -->
    <uses-permission android:name="android.permission.CAMERA" /> <!-- Config.bat: CAMERA -->
    <uses-feature android:name="android.hardware.camera" android:required="false" /> <!-- Config.bat: CAMERA -->
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" /> <!-- Config.bat: CAMERA -->

    <application android:label="{{LABEL}}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
        android:enableOnBackInvokedCallback="false"
        android:extractNativeLibs="false"
        android:hardwareAccelerated="true">

        <!-- SDL hints can be set here too, for example:
        <meta-data android:name="SDL_ENV.SDL_ANDROID_TRAP_BACK_BUTTON" android:value="0"/>
        -->

        <meta-data android:name="SDL_ENV.SDL_ORIENTATIONS" android:value="{{SDL_ORIENTATIONS}}" />

        <activity android:name="org.libsdl.app.SDLActivity"
            android:label="{{LABEL}}"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true"
            android:screenOrientation="{{SCREEN_ORIENTATION}}"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Let Android know that we can handle some USB devices and should receive this event -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </activity>
    </application>

</manifest>
