  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Makefile</ConfigurationType>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <PlatformToolset Condition="Exists('$(VCTargetsPath)Platforms\$(Platform)\PlatformToolsets\ClangCL')">ClangCL</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ItemDefinitionGroup>
    <ClCompile>
      <CompileAs>CompileAsCpp</CompileAs>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- Platform outputs -->
  <PropertyGroup Condition="'$(Configuration)'=='Web'">
    <OutputFile>index.html</OutputFile>
  </PropertyGroup>
  <!-- End of Platform outputs -->
  <PropertyGroup>
    <BuildConfiguration Condition="'$(Configuration)'=='Windows (Debug)'">Debug</BuildConfiguration>
    <BuildConfiguration Condition="'$(Configuration)'=='Windows (Release)'">Release</BuildConfiguration>
    <BuildPlatform>$(Platform)</BuildPlatform>
    <BuildPlatform Condition="'$(Platform)'=='Win32'">x86</BuildPlatform>
    <OutputFolder>Windows\$(BuildPlatform)\$(BuildConfiguration)</OutputFolder>
    <!-- Every other configuration is a folder in Framework\Automations\Platforms, built as Release -->
    <IsPlatform Condition="'$(BuildConfiguration)'==''">true</IsPlatform>
    <OutputFile Condition="'$(OutputFile)'=='' and '$(IsPlatform)'=='true'">$(GameName)</OutputFile>
    <OutputFile Condition="'$(OutputFile)'==''">$(GameName).exe</OutputFile>
    <BuildConfiguration Condition="'$(IsPlatform)'=='true'">Release</BuildConfiguration>
    <BuildPlatform Condition="'$(IsPlatform)'=='true'">$(Configuration)</BuildPlatform>
    <OutputFolder Condition="'$(IsPlatform)'=='true'">$(Configuration)\Release</OutputFolder>
    <PlatformScript>$(ProjectDir)Framework\Automations\Platforms\$(Configuration)\Build.bat</PlatformScript>
    <NMakeBuildCommandLine>Framework\Automations\Build.bat $(BuildConfiguration) $(BuildPlatform)</NMakeBuildCommandLine>
    <NMakeReBuildCommandLine>Framework\Automations\Clean.bat &amp;&amp; Framework\Automations\Build.bat $(BuildConfiguration) $(BuildPlatform)</NMakeReBuildCommandLine>
    <NMakeCleanCommandLine>Framework\Automations\Clean.bat</NMakeCleanCommandLine>
    <OutDir>$(ProjectDir)Builds\Outputs\$(OutputFolder)\</OutDir>
    <NMakeOutput>$(OutDir)$(OutputFile)</NMakeOutput>
    <NMakeIncludeSearchPath>$(ProjectDir)Libraries\SDL3\include;$(ProjectDir)Libraries;$(ProjectDir);$(IncludePath)</NMakeIncludeSearchPath>
    <LocalDebuggerCommand>$(NMakeOutput)</LocalDebuggerCommand>
    <LocalDebuggerWorkingDirectory>$(OutDir)</LocalDebuggerWorkingDirectory>
    <IntDir>$(ProjectDir).vs\Intermediate\$(Platform)\$(Configuration)\</IntDir>
    <AdditionalOptions>/std:c++20</AdditionalOptions>
  </PropertyGroup>
  <!-- F5 and Ctrl+F5 on a platform run "Build.bat run" in its folder: in a browser, on a phone, in WSL... -->
  <PropertyGroup Condition="'$(IsPlatform)'=='true' and Exists('$(PlatformScript)') and $([System.IO.File]::ReadAllText('$(PlatformScript)').Contains(':run'))">
    <LocalDebuggerCommand>$(ComSpec)</LocalDebuggerCommand>
    <LocalDebuggerCommandArguments>/c call "$(PlatformScript)" run || pause</LocalDebuggerCommandArguments>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BuildConfiguration)'=='Debug'">
    <NMakePreprocessorDefinitions>IS_DEBUG</NMakePreprocessorDefinitions>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
